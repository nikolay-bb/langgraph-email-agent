# Copy this file to .env and fill it in. Never commit .env.

# --- Model (required) ---
OPENAI_API_KEY=

# --- LangSmith tracing (optional) ---
# true sends a record of each run to LangSmith, the text of your emails included.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langgraph-email-agent
# EU region. For the US region use https://api.smith.langchain.com
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# --- Telegram bot (required for the bot and its tests) ---
# The token from @BotFather.
TELEGRAM_BOT_TOKEN=
# The one chat the bot answers. Every other chat is ignored.
TELEGRAM_CHAT_ID=

# --- Optional, with their defaults ---
# TELEGRAM_ASSISTANT_ID=email_assistant_hitl_memory_gmail
# TELEGRAM_PREFS_ASSISTANT_ID=preferences
# LANGGRAPH_URL=http://127.0.0.1:2024
# TELEGRAM_POLL_SECONDS=5
# TELEGRAM_ENABLE_EDIT=0
# TELEGRAM_MEMORY_NAMESPACE=email_assistant
# TELEGRAM_STATE_FILE=logs/telegram_bot_state.json
# TELEGRAM_ALLOW_IPV6=
# GOOGLE_ALLOW_IPV6=

# The Gmail sign-in is not set here. It is two files that setup_gmail.py uses:
#   src/email_assistant/tools/gmail/.secrets/secrets.json   (your OAuth client, from Google Cloud)
#   src/email_assistant/tools/gmail/.secrets/token.json     (written by setup_gmail.py)
